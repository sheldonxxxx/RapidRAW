{
  "name": "rapidraw-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP interface to RapidRAW's native nondestructive photo engine",
  "type": "module",
  "bin": {
    "rapidraw-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:engine": "npm run build && node scripts/engine-e2e.mjs",
    "test:assets": "npm run build && node scripts/asset-e2e.mjs",
    "test:review-jobs": "npm run build && node scripts/review-jobs-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
