  "method": {
    "generation_area": "1 MP means a target of 1024 × 1024 pixels in area, aspect-preserving and rounded to multiples of 16; it is not a 1024-pixel edge limit.",
    "conditioning": "JPEG RGB derived from decoded RAW and visible AI patches. Global tone, LUT and denoise adjustments are not baked into model conditioning.",
    "native_delivery": "Restore generated RGB to the recorded native context; RapidRAW applies the original selection alpha once. Full photo dimensions do not describe neural generation resolution.",
    "production_crop": {
      "margin_fraction": 0.5,
      "minimum_margin_pixels": 64,
      "dimension_multiple": 16,
      "rule": "Expand the nonzero selection bounds by max(64, ceil(0.5 × longest selection edge)), clipped to the source.",
      "scope": "Default production context only. The bundled closer-context profile uses margin_fraction 0.1 with the same 64-pixel minimum."
    },
    "fixed_crop_comparisons": "Mask-size experiments used the same explicit context ROI for both masks. These differ from native production mask-derived crops; compare the recorded dimensions.",
    "randomness": "Use one explicit seed for a matched comparison; the complex examples used 104729. A seed is not a general quality recommendation. Different code, precision or devices may change pixels.",
    "super_resolution": "Freeze the generated crop; compare direct Lanczos restoration and scale-matched Lanczos controls against SR; then restore to identical native placement and apply the unchanged mask once.",
    "super_resolution_result": "The tested SR combinations did not justify a default enhancement stage. Sharper intermediates sometimes worsened native texture or invented structure. These observations apply to these exact checkpoints/settings.",
    "negative_prompt": "Store the effective request negative prompt separately. The complex API comparisons used empty negatives; native requests may supply one. Klein uses zeroed negative conditioning."
  },
  "timing_scopes": {
    "comfy_graph": "Executed graph through output encoding, excluding source transfer, native patch application and full-image export. First calls and model switches are separate observations, not pure GPU kernel timings.",
    "native_first_visible": "Native retouch request through the first 1600-pixel preview; includes connector work and native preview rendering, excludes final full-resolution benchmark export.",
    "postprocess_comfy_execution_wall": "Only the added SR graph; never compare this number directly with complete inpaint latency. Parent generation plus SR is a derived arithmetic sum, not a measured click-to-result time.",
    "comparison_limits": "Profile samples cover different small case sets. Early cold loads overlapped disk-intensive transfers; later first calls also reflect residency and cache state. No global winner or stable tail-latency claim follows."
  },
